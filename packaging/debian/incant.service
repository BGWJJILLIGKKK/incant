[Unit]
Description=Incant ebook and audiobook publishing
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=incant
Group=incant
StateDirectory=incant
StateDirectoryMode=0750
CacheDirectory=incant
CacheDirectoryMode=0750
WorkingDirectory=/var/lib/incant
Environment=HOME=/var/lib/incant
Environment=INCANT_DATA=/var/lib/incant
Environment=INCANT_HOME=/usr/lib/incant
Environment=XDG_CACHE_HOME=/var/cache/incant
Environment=INCANT_KOKORO_DIR=/var/cache/incant/kokoro
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/cache/incant/playwright
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/incant/service.env
ExecStart=/usr/bin/incant --serve
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=3s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
